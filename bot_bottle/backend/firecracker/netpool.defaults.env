# Firecracker network-pool defaults, read by netpool.py,
# scripts/firecracker-netpool.sh and nix/firecracker-netpool.nix. A
# BOT_BOTTLE_FC_* env var of the same name overrides each.
#
# Plain KEY=VALUE (no quotes, inline comments or spaces around `=`), so it can
# be sourced by sh, used as a systemd EnvironmentFile and parsed by Python and
# Nix.
BOT_BOTTLE_FC_POOL_SIZE=8
BOT_BOTTLE_FC_IP_BASE=10.243.0.0
BOT_BOTTLE_FC_IFACE_PREFIX=bbfc
BOT_BOTTLE_FC_NFT_TABLE=bot_bottle_fc
# The orchestrator VM's TAP, outside the agent pool and NAT'd out (it pulls
# bases and packages for builds). Its /31 is the top of the /16.
BOT_BOTTLE_FC_ORCH_IFACE=bborch0
# The gateway VM's TAP: NAT'd out, with a forward path to the orchestrator.
# The /31 above the orchestrator's. Agents DNAT here, never to the
# orchestrator.
BOT_BOTTLE_FC_GW_IFACE=bbgw0
# Slices reserved after the live pool, one per named environment
# (BOT_BOTTLE_ENV): slice k uses base + 256k, TAPs bb{k}fc*, nft table
# bot_bottle_fc{k} and infra links bborch{k}/bbgw{k}. At most 63.
BOT_BOTTLE_FC_ENV_SLOTS=4
